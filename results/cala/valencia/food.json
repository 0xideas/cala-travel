    {
      "name": "Paella Valenciana",
      "recommendation_type": "Casa Carmela",
      "locality_or_neighbourhood": "La Malvarrosa (Poblats Marítims)",
      "why_it_is_special": "Family-run since 1922, every paella is cooked over an open wood fire — the traditional method that produces the prized socarrat (crispy caramelised rice crust). Locals and food critics consistently rank it among the city's best.",
      "source_url": "theinfatuation.com/valencia/reviews/casa-carmela"
    },
    {
      "name": "Horchata con Fartons",
      "recommendation_type": "Horchatería Daniel",
      "locality_or_neighbourhood": "Alboraya (Avenida de la Horchata)",
      "why_it_is_special": "Operating since 1949, Daniel crafts 100 % natural, artisan horchata from locally grown tiger nuts (chufas). Salvador Dalí and Rafael Alberti were among its famous patrons. The soft, sugar-glazed fartons are baked in-house for dipping.",
      "source_url": "visitvalencia.com/en/what-to-do-valencia/gastronomy/spaces-gastronomic-valencia/horchateria-daniel"
    },
    {
      "name": "All i Pebre",
      "recommendation_type": "Bon Aire",
      "locality_or_neighbourhood": "El Palmar (Albufera Natural Park)",
      "why_it_is_special": "A bold garlic-and-paprika eel stew born in the fishing villages around L'Albufera lake. Chef Raúl Magraner runs this family project using local rice, fish, and vegetables from the park's own environment. Bon Aire holds a We're Smart Green Guide distinction.",
      "source_url": "visitvalencia.com/en/what-to-do-valencia/gastronomy/where-to-eat-restaurant-valencia/bon-aire-restaurante"
    },
    {
      "name": "Fideuà",
      "recommendation_type": "Goya Gallery",
      "locality_or_neighbourhood": "L'Eixample (Carrer de Borriana, 3)",
      "why_it_is_special": "A Michelin Guide–listed restaurant that started as a bar in 1950 and won the title of best fideuà in the world in 2022. Its loyal local following and superb selection of rice and noodle dishes make it a neighbourhood institution rather than a tourist stop.",
      "source_url": "guide.michelin.com/hu/en/comunidad-valenciana/valencia/restaurant/goya-gallery"
    },
    {
      "name": "Esgarraet",
      "recommendation_type": "Casa Montaña",
      "locality_or_neighbourhood": "El Cabanyal",
      "why_it_is_special": "A historic bodega in Valencia's old fishermen's quarter, Casa Montaña is the kind of place where locals linger over vermouth and traditional tapas. Esgarraet — hand-shredded salt cod with smoky roasted red peppers and olive oil — is a house staple that showcases the simplicity of Valencian coastal cooking.",
      "source_url": "theinfatuation.com/valencia/reviews/casa-montana"
    }
  ],
