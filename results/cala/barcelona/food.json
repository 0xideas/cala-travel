    {
      "name": "Bomba",
      "recommendation_type": "La Cova Fumada",
      "locality_or_neighbourhood": "La Barceloneta",
      "why_it_is_special": "Family-run bodega opened in 1944, widely credited as the birthplace of the bomba. No sign on the door, no reservations — just marble tables, chalkboard menus, and fiercely loyal locals. A full tapas feast still costs under €20.",
      "source_url": "https://www.theinfatuation.com/barcelona/reviews/la-cova-fumada"
    },
    {
      "name": "Pa amb tomàquet",
      "recommendation_type": "Taverna El Glop",
      "locality_or_neighbourhood": "Gràcia",
      "why_it_is_special": "Founded in 1978 during the Gràcia neighbourhood festival, this cosy institution serves classic Catalan cuisine with fresh, local produce. Pa amb tomàquet is so fundamental here it doesn't even need to be on the menu — just ask. A 10-minute walk from Gaudí's Casa Vicens.",
      "source_url": "https://elglop.com/en/taverna-el-glop"
    },
    {
      "name": "Escalivada",
      "recommendation_type": "Bar Casi",
      "locality_or_neighbourhood": "Gràcia (near Joanic metro)",
      "why_it_is_special": "An unassuming neighbourhood bar where vocal locals crowd in for some of the best home-cooked food in the city at an outstanding quality-to-price ratio. A great stop before or after Park Güell.",
      "source_url": "https://barcelonahacks.com/what-to-eat-in-barcelona"
    },
    {
      "name": "Pescadito frito",
      "recommendation_type": "Bar La Plata",
      "locality_or_neighbourhood": "Barri Gòtic (Gothic Quarter)",
      "why_it_is_special": "Open since 1945, serving exactly four tapas — fried butifarra, anchovies, tomato salad, and the star: crispy pescaditos (€3). Named best tapas bar in Barcelona by Time Out and best tiny bar in Europe by The Guardian. Chef Ferran Adrià calls it \"a magical place.\"",
      "source_url": "https://www.theinfatuation.com/barcelona/reviews/la-plata"
    },
    {
      "name": "Crema catalana",
      "recommendation_type": "Granja Dulcinea",
      "locality_or_neighbourhood": "Ciutat Vella (Carrer de Petritxol, Gothic Quarter)",
      "why_it_is_special": "A historic granja (tea room) on Barcelona's famed \"Chocolate Street,\" open since 1941. Generations of locals have come for its thick hot chocolate and traditional Catalan sweets. The interior has barely changed since the 1950s — a genuine time capsule of mid-20th-century Barcelona.",
      "source_url": "https://atlasobscura.com/places/granja-dulcinea"
    }
